# Maintainer: Pranav <Prs96@users.noreply.github.com>
pkgname=khzgo
pkgver=0.1.0
pkgrel=1
pkgdesc="Minimal terminal music player with cover art"
arch=('x86_64' 'aarch64')
url="https://github.com/Prs96/khzgo"
license=('MIT')
depends=('glibc' 'mpv' 'chafa' 'ffmpeg')
makedepends=('go')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('06ce2e39060c099c090f1b1fce603bd194487e8539ee80c1d74e43942467774e')

build() {
  cd "$pkgname-$pkgver"
  export CGO_ENABLED=0
  export GOFLAGS=-trimpath
  go build -ldflags "-s -w -X main.version=$pkgver" -o khzgo .
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 khzgo "$pkgdir/usr/bin/khzgo"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
